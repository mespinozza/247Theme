{%- comment -%}
  "Featured in this article" list for blog posts.
  Accepts:
  - article: {Object} the current article
  - block: {Object} the main-article "featured_links" block

  Product and collection links are read from the article body in the order
  they appear, then manually picked products/collections are appended.
  Entries are stored as "kind:handle~~link text" separated by "|".
  Links whose product/collection no longer exists still get a card, pointing
  to a store search for the link text instead of the missing page.
{%- endcomment -%}

{%- liquid
  assign max_items = block.settings.max_items | default: 8
  assign entries = '|'

  if block.settings.auto_detect
    assign chunks = article.content | split: 'href="'
    for chunk in chunks offset: 1
      assign url = chunk | split: '"' | first | split: '?' | first | split: '#' | first
      assign kind = blank
      assign handle = blank

      if url contains '/products/'
        assign kind = 'p'
        assign handle = url | split: '/products/' | last | split: '/' | first
      elsif url contains '/collections/'
        assign handle = url | split: '/collections/' | last | split: '/' | first
        unless handle == 'all' or handle == 'vendors' or handle == 'types'
          assign kind = 'c'
        endunless
      endif

      if kind != blank and handle != blank
        assign needle = '|' | append: kind | append: ':' | append: handle | append: '~~'
        unless entries contains needle
          assign anchor = chunk | split: '</a>' | first
          assign link_text = '<a href="' | append: anchor | strip_html | replace: '|', ' ' | replace: '~~', ' ' | strip
          assign entries = entries | append: kind | append: ':' | append: handle | append: '~~' | append: link_text | append: '|'
        endunless
      endif
    endfor
  endif

  for collection_item in block.settings.collections
    assign needle = '|c:' | append: collection_item.handle | append: '~~'
    unless entries contains needle
      assign entries = entries | append: 'c:' | append: collection_item.handle | append: '~~|'
    endunless
  endfor

  for product_item in block.settings.products
    assign needle = '|p:' | append: product_item.handle | append: '~~'
    unless entries contains needle
      assign entries = entries | append: 'p:' | append: product_item.handle | append: '~~|'
    endunless
  endfor

  assign entry_list = entries | split: '|'
-%}

{%- capture items -%}
  {%- assign shown = 0 -%}
  {%- for entry in entry_list -%}
    {%- if shown >= max_items -%}{%- break -%}{%- endif -%}
    {%- assign kind = entry | slice: 0, 2 -%}
    {%- unless kind == 'p:' or kind == 'c:' -%}{%- continue -%}{%- endunless -%}

    {%- assign entry_parts = entry | remove_first: kind | split: '~~' -%}
    {%- assign handle = entry_parts[0] -%}
    {%- assign link_text = entry_parts[1] | default: '' | strip -%}
    {%- if link_text == blank -%}
      {%- assign link_text = handle | replace: '-', ' ' | capitalize -%}
    {%- endif -%}

    {%- if kind == 'p:' -%}
      {%- assign item = all_products[handle] -%}
      {%- assign label = block.settings.product_label -%}
      {%- assign cta = block.settings.product_cta -%}
    {%- else -%}
      {%- assign item = collections[handle] -%}
      {%- assign label = block.settings.collection_label -%}
      {%- assign cta = block.settings.collection_cta -%}
    {%- endif -%}

    {%- if item != blank and item.id != blank -%}
      {%- assign item_title = item.title -%}
      {%- assign item_url = item.url -%}
    {%- else -%}
      {%- assign item = nil -%}
      {%- assign item_title = link_text -%}
      {%- assign search_terms = link_text | replace: '&amp;', '&' | url_encode -%}
      {%- assign item_url = routes.search_url | append: '?q=' | append: search_terms -%}
      {%- if kind == 'p:' -%}
        {%- assign item_url = item_url | append: '&type=product' -%}
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      assign shown = shown | plus: 1
      assign add_variant = nil
      if kind == 'p:' and item and block.settings.show_add_to_cart
        assign quote_only = false
        if item.template_suffix == 'per-quote-product' or item.template_suffix == 'discontinued-product'
          assign quote_only = true
        endif
        if item.has_only_default_variant and item.available and item.price > 0 and quote_only == false
          assign add_variant = item.selected_or_first_available_variant
        endif
      endif
    -%}
    <li class="featured-links__item">
      <div class="featured-links__card">
        <a href="{{ item_url }}" class="featured-links__row">
          <span class="featured-links__thumb">
            {%- if kind == 'p:' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg>
            {%- endif -%}
          </span>
          <span class="featured-links__text">
            <span class="featured-links__label">{{ label }}</span>
            <span class="featured-links__title">{{ item_title | escape_once }}</span>
            {%- if kind == 'p:' and item and block.settings.show_price and item.price > 0 -%}
              <span class="featured-links__price">{{ item.price | money }}</span>
            {%- endif -%}
          </span>
        </a>
        {%- if add_variant -%}
          <product-form class="featured-links__form">
            <div class="product-form__error-message-wrapper featured-links__error" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            {%- form 'product', item, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ add_variant.id }}">
              <button
                type="submit"
                name="add"
                class="featured-links__add"
                aria-label="{{ 'products.product.add_to_cart' | t }}: {{ item.title | escape }}"
              >
                <span>{{ 'products.product.add_to_cart' | t }}</span>
                <div class="loading-overlay__spinner hidden">
                  <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a href="{{ item_url }}" class="featured-links__cta">
            {{- cta -}}
            {%- render 'featured-links-chevron' -%}
          </a>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- assign items = items | strip -%}
{%- if items != blank -%}
  <div class="featured-links" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="featured-links__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="featured-links__list" role="list">
      {{ items }}
    </ul>
  </div>
{%- endif -%}
