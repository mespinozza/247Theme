{%- comment -%}
  Kitchen-themed fallback image for cards without a featured image.
  Accepts:
  - seed: {Number} used to pick one of the icons (e.g. article.id)
  - topic: {String} optional text (e.g. article.title) used to match a topic icon before falling back to seed
{%- endcomment -%}

{%- liquid
  assign variant = seed | default: 0 | modulo: 3
  assign topic_text = topic | downcase
  if topic_text contains 'refrigerat' or topic_text contains 'freezer' or topic_text contains 'ice machine' or topic_text contains 'cooler' or topic_text contains 'chiller'
    assign variant = 'cold'
  elsif topic_text contains 'espresso' or topic_text contains 'coffee' or topic_text contains 'wine' or topic_text contains 'beverage'
    assign variant = 'drink'
  elsif topic_text contains 'oven' or topic_text contains 'fryer' or topic_text contains 'griddle' or topic_text contains 'range' or topic_text contains 'charbroiler' or topic_text contains 'toaster' or topic_text contains 'steam' or topic_text contains 'kettle' or topic_text contains 'pizza'
    assign variant = 'heat'
  endif
-%}

<div class="kitchen-placeholder" role="img" aria-label="{{ shop.name | escape }}">
  <svg
    class="kitchen-placeholder__icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {%- case variant -%}
      {%- when 'cold' -%}
        <path d="M2 12h20"/>
        <path d="M12 2v20"/>
        <path d="m20 16-4-4 4-4"/>
        <path d="m4 8 4 4-4 4"/>
        <path d="m16 4-4 4-4-4"/>
        <path d="m8 20 4-4 4 4"/>
      {%- when 'drink' -%}
        <path d="M10 2v2"/>
        <path d="M14 2v2"/>
        <path d="M6 2v2"/>
        <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/>
      {%- when 'heat' -%}
        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
      {%- when 0 -%}
        <path d="M9 2.5c-.6.8-.6 1.7 0 2.5"/>
        <path d="M12 2.5c-.6.8-.6 1.7 0 2.5"/>
        <path d="M15 2.5c-.6.8-.6 1.7 0 2.5"/>
        <path d="M10 8h4"/>
        <path d="M4 10h16"/>
        <path d="M5 10v7a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-7"/>
        <path d="M2 12h3"/>
        <path d="M19 12h3"/>
      {%- when 1 -%}
        <path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/>
        <path d="M6 17h12"/>
      {%- else -%}
        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
        <path d="M7 2v20"/>
        <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
    {%- endcase -%}
  </svg>
</div>
