{{ 'collection-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign text_rgb = section.settings['color-body-text'] | color_to_rgb
  assign panel_rgb = section.settings['panel_color'] | color_to_rgb
  assign tile_rgb = section.settings['image_background'] | color_to_rgb

  if collection.image != blank
    assign banner_image = collection.image
  elsif section.settings.fallback_image_desktop != blank
    assign banner_image = section.settings.fallback_image_desktop
  else
    assign banner_image = blank
  endif

  assign has_description = false
  if section.settings.show_collection_description and collection.description != blank
    assign has_description = true
    assign description_text = collection.description | strip_html | strip
    assign description_is_long = false
    if description_text.size > 220
      assign description_is_long = true
    endif
  endif
-%}

<style>
  [data-section-id="{{ section.id }}"] {
    {% if section.settings.margin-top %}
      --section-gap-top: {{ section.settings.margin-top }}px;
    {% endif %}
    {% if section.settings.margin-bottom %}
      --section-gap-bottom: {{ section.settings.margin-bottom }}px;
    {% endif %}
    {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --collection-header-text: {{ section.settings['color-body-text'] }};
    {% endif %}
    {% if panel_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --collection-header-panel: {{ section.settings.panel_color }};
    {% endif %}
    {% if tile_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --collection-header-tile: {{ section.settings.image_background }};
    {% endif %}
    --collection-header-tile-height: {{ section.settings.image_height_mobile }}px;
    --collection-header-tile-height-desk: {{ section.settings.image_height }}px;
    --font-headline-scale-desk: {{ section.settings.size_heading | divided_by: 100.0 }};
    --font-headline-scale: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};
  }
</style>

<div
  data-section-id="{{ section.id }}"
  class="collection-header{% if section.settings['full-width-enabled'] %} collection-header--full{% endif %}"
>
  <div
    class="collection-header__panel collection-header__panel--{{ section.settings.layout }} collection-header__panel--mobile-{{ section.settings.mobile_text_horizontal_position }}{% if banner_image == blank %} collection-header__panel--no-image{% endif %}{% if settings.animations %} scroll-trigger animate--slide-in{% endif %}{% if settings.disabled_animations_on_mobile %} disabled-on-mobile{% endif %}"
  >
    {%- if banner_image != blank -%}
      <div class="collection-header__media collection-header__media--{{ section.settings.image_fit }}">
        {{
          banner_image
          | image_url: width: 1200
          | image_tag:
            widths: '300, 450, 600, 900, 1200',
            sizes: '(min-width: 990px) 420px, 90vw',
            alt: collection.title,
            fetchpriority: 'high',
            class: 'collection-header__image'
        }}
      </div>
    {%- endif -%}

    <div class="collection-header__info">
      {%- if section.settings.show_product_count -%}
        <p class="collection-header__eyebrow">
          {{ 'products.facets.product_count_simple' | t: count: collection.all_products_count }}
        </p>
      {%- endif -%}

      <h1 class="collection-header__title">{{ collection.title | escape }}</h1>

      {%- if has_description -%}
        <div class="collection-header__description rte" data-collection-description>
          {%- if description_is_long -%}
            <div class="collection-header__description-preview">
              <p>{{ description_text | truncate: 220 }}</p>
            </div>
            <div class="collection-header__description-full" hidden>
              {{ collection.description }}
            </div>
            <button
              type="button"
              class="collection-header__toggle"
              aria-expanded="false"
              data-more="Read more"
              data-less="Read less"
              onclick="
                var d = this.closest('[data-collection-description]');
                var open = this.getAttribute('aria-expanded') === 'true';
                d.querySelector('.collection-header__description-preview').hidden = !open;
                d.querySelector('.collection-header__description-full').hidden = open;
                this.setAttribute('aria-expanded', String(!open));
                this.firstElementChild.textContent = open ? this.dataset.more : this.dataset.less;
              "
            >
              <span>Read more</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          {%- else -%}
            {{ collection.description }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "collection-banner spaced-section spaced-section--full-width",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": true,
      "label": "Show product count"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image style",
      "options": [
        { "value": "contain", "label": "Logo (fit inside tile)" },
        { "value": "cover", "label": "Photo (fill tile)" }
      ],
      "default": "contain",
      "info": "Logo keeps every brand logo uncropped at the same size."
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 200,
      "label": "Image tile height (Desktop)"
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140,
      "label": "Image tile height (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "fallback_image_desktop",
      "label": "Fallback image",
      "info": "Displayed when a collection has no image set"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "t:sections.image-with-text.settings.layout.options__1.label" },
        { "value": "text_first", "label": "t:sections.image-with-text.settings.layout.options__2.label" }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label",
      "info": "Desktop only. On mobile the image is always on top."
    },
    {
      "type": "select",
      "id": "mobile_text_horizontal_position",
      "options": [
        { "value": "left", "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.left.label" },
        { "value": "center", "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.center.label" }
      ],
      "default": "left",
      "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.label"
    },
    {
      "type": "checkbox",
      "id": "full-width-enabled",
      "label": "t:sections.settings.settings.section-full-width.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.text"
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading.label",
      "unit": "%"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 130,
      "label": "t:sections.settings.settings.size-heading-mobile.label",
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "panel_color",
      "default": "transparent",
      "label": "Panel background"
    },
    {
      "type": "color",
      "id": "image_background",
      "default": "transparent",
      "label": "Image tile background"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 16,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 16,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
