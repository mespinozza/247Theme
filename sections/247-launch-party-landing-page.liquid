<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet">

<style>
  .lp-wrap {
    --navy: #0f1923;
    --red: #a20d17;
    --blue: #0400c2;
    --blue-bright: #0508a3;
    --text: #222321;
    --off-white: #f4f5f7;
    font-family: 'Barlow Condensed', Arial, sans-serif;
    color: var(--text);
    background: var(--off-white);
  }
  .lp-wrap * { box-sizing: border-box; }

  /* HERO */
  .lp-hero {
    background: var(--navy);
    color: #fff;
    padding: 64px 20px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .lp-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(4,0,194,0.25) 0%, rgba(162,13,23,0.15) 100%);
    pointer-events: none;
  }
  .lp-hero-inner { position: relative; max-width: 900px; margin: 0 auto; }
  .lp-eyebrow {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 20px;
    color: #cfd6e0;
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }
  .lp-h1 {
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(36px, 7vw, 64px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    margin: 0 0 18px;
  }
  .lp-h1 span { color: #ff5a63; }
  .lp-hero-sub {
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 500;
    color: #dfe3ea;
    max-width: 620px;
    margin: 0 auto 28px;
  }
  .lp-date-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    padding: 10px 22px;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 36px;
  }

  /* EMBED / REGISTER BLOCK */
  #register {
    max-width: 720px;
    margin: 0 auto;
    background: #fff;
    border-radius: 14px;
    padding: 10px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  }
  .lp-embed-frame {
    width: 100%;
    height: 0;
    position: relative;
    padding-bottom: 56.25%;
    border-radius: 8px;
    overflow: hidden;
  }
  .lp-embed-frame iframe {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    border: 0;
  }

  /* SECTION SHARED */
  .lp-section {
    max-width: 1080px;
    margin: 0 auto;
    padding: 64px 20px;
  }
  .lp-section-title {
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(28px, 4vw, 40px);
    text-align: center;
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }
  .lp-section-title .accent { color: var(--red); }
  .lp-section-sub {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 19px;
    color: #555;
    max-width: 640px;
    margin: 0 auto 40px;
  }

  /* WHAT TO EXPECT */
  .lp-expect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .lp-expect-card {
    background: #fff;
    border-radius: 10px;
    padding: 24px;
    border-top: 4px solid var(--blue);
    text-align: center;
  }
  .lp-expect-card h3 {
    font-size: 22px;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .lp-expect-card p { font-size: 16px; line-height: 1.5; color: #444; margin: 0; }

  /* VENDOR GRID */
  .lp-vendor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }
  .lp-vendor-card {
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e3e5ea;
    display: flex;
    flex-direction: column;
  }
  .lp-vendor-logo-wrap {
    background: var(--navy);
    padding: 28px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 90px;
  }
  .lp-vendor-logo-wrap img { max-height: 48px; max-width: 80%; filter: brightness(0) invert(1); }
  .lp-vendor-body { padding: 20px 22px 24px; flex: 1; }
  .lp-vendor-name {
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .lp-vendor-tag {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: var(--red);
    font-size: 16px;
    margin: 0 0 10px;
  }
  .lp-vendor-desc { font-size: 15px; line-height: 1.5; color: #444; margin: 0; }

  /* STUDIO NOTE */
  .lp-studio-note {
    background: var(--red);
    color: #fff;
    text-align: center;
    padding: 40px 20px;
  }
  .lp-studio-note p {
    max-width: 700px;
    margin: 0 auto;
    font-size: 20px;
    font-weight: 600;
  }

  /* SECOND CTA */
  .lp-cta-band {
    background: var(--blue);
    color: #fff;
    text-align: center;
    padding: 56px 20px;
  }
  .lp-cta-band h2 {
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(26px, 4vw, 36px);
    margin: 0 0 20px;
  }
  .lp-btn {
    display: inline-block;
    background: #fff;
    color: var(--blue);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 18px;
    letter-spacing: 0.5px;
    padding: 16px 40px;
    border-radius: 6px;
    text-decoration: none;
  }
  .lp-btn:hover { opacity: 0.9; }

  /* FAQ */
  .lp-faq { max-width: 760px; margin: 0 auto; }
  .lp-faq details {
    background: #fff;
    border: 1px solid #e3e5ea;
    border-radius: 8px;
    padding: 18px 22px;
    margin-bottom: 12px;
  }
  .lp-faq summary {
    font-weight: 700;
    font-size: 18px;
    cursor: pointer;
    list-style: none;
  }
  .lp-faq summary::-webkit-details-marker { display: none; }
  .lp-faq summary::after {
    content: "+";
    float: right;
    font-size: 22px;
    color: var(--red);
  }
  .lp-faq details[open] summary::after { content: "–"; }
  .lp-faq p { margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: #444; }

  @media (max-width: 640px) {
    .lp-section { padding: 44px 16px; }
  }
</style>

